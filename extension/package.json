{
	"name": "vscode-pokemon",
	"displayName": "VS Code Pokemon (내 PC)",
	"description": "Pokémon for your VS Code",
	"version": "5.0.2",
	"engines": {
		"vscode": "^1.73.0"
	},
	"l10n": "./l10n",
	"repository": {
		"type": "github",
		"url": "https://github.com/jakobhoeg/vscode-pokemon"
	},
	"homepage": "https://github.com/jakobhoeg/vscode-pokemon",
	"bugs": "https://github.com/jakobhoeg/vscode-pokemon/issues",
	"publisher": "local",
	"pricing": "Free",
	"categories": [
		"Other"
	],
	"keywords": [
		"pokemon",
		"pets",
		"pokémon",
		"pixelart",
		"pixel",
		"pixel",
		"vscode"
	],
	"license": "MIT",
	"icon": "icon.png",
	"activationEvents": [
		"onCommand:vscode-pokemon.start",
		"onCommand:vscode-pokemon.spawn-pokemon",
		"onCommand:vscode-pokemon.spawn-random-pokemon",
		"onCommand:vscode-pokemon.delete-pokemon",
		"onCommand:vscode-pokemon.remove-all-pokemon",
		"onCommand:vscode-pokemon.roll-call",
		"onCommand:vscode-pokemon.export-pokemon-list",
		"onCommand:vscode-pokemon.import-pokemon-list",
		"onCommand:vscode-pokemon.configure-keybindings",
		"onCommand:vscode-pokemon.change-pokemon-language",
		"onWebviewPanel:pokemonCoding",
		"onView:explorer",
		"onView:pokemonView",
		"onStartupFinished",
		"onCommand:vscode-pokemon.settings-menu",
		"onCommand:vscode-pokemon.game-mode",
		"onCommand:vscode-pokemon.normal-mode",
		"onCommand:vscode-pokemon.team-out",
		"onCommand:vscode-pokemon.team-in"
	],
	"main": "./out/extension/extension.js",
	"browser": "./dist/web/extension-web.js",
	"contributes": {
		"views": {
			"explorer": [
				{
					"type": "webview",
					"id": "pokemonView",
					"name": "포켓몬",
					"when": "vscode-pokemon.position == 'explorer'",
					"icon": "media/icon/dark-add.svg"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "vscode-pokemon.game-mode",
					"when": "view == pokemonView && vscode-pokemon.gameAvailable && !vscode-pokemon.gameMode",
					"group": "navigation@-2"
				},
				{
					"command": "vscode-pokemon.normal-mode",
					"when": "view == pokemonView && vscode-pokemon.gameMode",
					"group": "navigation@-2"
				},
				{
					"command": "vscode-pokemon.team-out",
					"when": "view == pokemonView && vscode-pokemon.gameAvailable && !vscode-pokemon.gameMode && !vscode-pokemon.teamOut",
					"group": "navigation@-1"
				},
				{
					"command": "vscode-pokemon.team-in",
					"when": "view == pokemonView && vscode-pokemon.gameAvailable && !vscode-pokemon.gameMode && vscode-pokemon.teamOut",
					"group": "navigation@-1"
				},
				{
					"command": "vscode-pokemon.settings-menu",
					"when": "view == pokemonView",
					"group": "navigation@0"
				},
				{
					"command": "vscode-pokemon.spawn-pokemon",
					"when": "view == pokemonView && !vscode-pokemon.gameMode",
					"group": "navigation@1"
				},
				{
					"command": "vscode-pokemon.spawn-random-pokemon",
					"when": "view == pokemonView && !vscode-pokemon.gameMode",
					"group": "navigation@2"
				},
				{
					"command": "vscode-pokemon.delete-pokemon",
					"when": "view == pokemonView && !vscode-pokemon.gameMode",
					"group": "navigation@3"
				}
			],
			"commandPalette": [
				{
					"command": "vscode-pokemon.game-mode",
					"when": "vscode-pokemon.gameAvailable && vscode-pokemon.position == 'explorer'"
				},
				{
					"command": "vscode-pokemon.normal-mode",
					"when": "vscode-pokemon.gameMode"
				},
				{
					"command": "vscode-pokemon.game-speed",
					"when": "vscode-pokemon.gameDev && vscode-pokemon.gameMode"
				},
				{
					"command": "vscode-pokemon.team-out",
					"when": "vscode-pokemon.gameAvailable && !vscode-pokemon.gameMode && !vscode-pokemon.teamOut && vscode-pokemon.position == 'explorer'"
				},
				{
					"command": "vscode-pokemon.team-in",
					"when": "vscode-pokemon.gameAvailable && !vscode-pokemon.gameMode && vscode-pokemon.teamOut"
				}
			]
		},
		"commands": [
			{
				"command": "vscode-pokemon.game-mode",
				"title": "게임 모드",
				"category": "포켓몬",
				"icon": {
					"dark": "media/icon/dark-game.svg",
					"light": "media/icon/light-game.svg"
				}
			},
			{
				"command": "vscode-pokemon.normal-mode",
				"title": "일반 모드로 (자동저장)",
				"category": "포켓몬",
				"icon": {
					"dark": "media/icon/dark-home.svg",
					"light": "media/icon/light-home.svg"
				}
			},
			{
				"command": "vscode-pokemon.team-out",
				"title": "내 포켓몬 꺼내기 (게임 팀)",
				"category": "포켓몬",
				"icon": "$(package)"
			},
			{
				"command": "vscode-pokemon.team-in",
				"title": "내 포켓몬 넣기 (게임 팀)",
				"category": "포켓몬",
				"icon": "$(archive)"
			},
			{
				"command": "vscode-pokemon.game-speed",
				"title": "게임 빨리 감기 (개발 창)",
				"category": "포켓몬"
			},
			{
				"command": "vscode-pokemon.settings-menu",
				"title": "설정",
				"category": "포켓몬",
				"icon": "$(gear)"
			},
			{
				"command": "vscode-pokemon.start",
				"title": "포켓몬 패널 열기",
				"category": "포켓몬"
			},
			{
				"command": "vscode-pokemon.export-pokemon-list",
				"title": "포켓몬 목록 내보내기",
				"category": "포켓몬"
			},
			{
				"command": "vscode-pokemon.import-pokemon-list",
				"title": "포켓몬 목록 가져오기",
				"category": "포켓몬"
			},
			{
				"command": "vscode-pokemon.spawn-pokemon",
				"title": "포켓몬 소환",
				"category": "포켓몬",
				"icon": {
					"dark": "media/icon/dark-add.svg",
					"light": "media/icon/light-add.svg"
				}
			},
			{
				"command": "vscode-pokemon.spawn-random-pokemon",
				"title": "무작위 포켓몬 소환",
				"category": "포켓몬",
				"icon": {
					"dark": "media/icon/dark-random.svg",
					"light": "media/icon/light-random.svg"
				}
			},
			{
				"command": "vscode-pokemon.delete-pokemon",
				"title": "포켓몬 지우기",
				"category": "포켓몬",
				"icon": {
					"dark": "media/icon/dark-trash.svg",
					"light": "media/icon/light-trash.svg"
				}
			},
			{
				"command": "vscode-pokemon.remove-all-pokemon",
				"title": "포켓몬 모두 지우기",
				"category": "포켓몬",
				"icon": {
					"dark": "media/icon/dark-trash.svg",
					"light": "media/icon/light-trash.svg"
				}
			},
			{
				"command": "vscode-pokemon.roll-call",
				"title": "출석 부르기",
				"category": "포켓몬"
			},
			{
				"command": "vscode-pokemon.configure-keybindings",
				"title": "단축키 설정",
				"category": "포켓몬"
			},
			{
				"command": "vscode-pokemon.change-pokemon-language",
				"title": "포켓몬 이름 언어 바꾸기",
				"category": "포켓몬"
			}
		],
		"keybindings": [
			{
				"command": "vscode-pokemon.game-mode",
				"key": "f3",
				"mac": "f3",
				"when": "vscode-pokemon.gameAvailable && vscode-pokemon.position == 'explorer'"
			},
			{
				"command": "vscode-pokemon.spawn-pokemon",
				"key": "alt+shift+w",
				"mac": "alt+shift+w"
			},
			{
				"command": "vscode-pokemon.spawn-random-pokemon",
				"key": "alt+shift+q",
				"mac": "alt+shift+q"
			},
			{
				"command": "vscode-pokemon.delete-pokemon",
				"key": "alt+shift+d",
				"mac": "alt+shift+d"
			},
			{
				"command": "vscode-pokemon.remove-all-pokemon",
				"key": "alt+shift+backspace",
				"mac": "alt+shift+backspace"
			}
		],
		"configuration": [
			{
				"title": "VS Code 포켓몬",
				"properties": {
					"vscode-pokemon.pokemonSize": {
						"type": "string",
						"enum": [
							"nano",
							"small",
							"medium",
							"large"
						],
						"default": "medium",
						"description": "포켓몬 크기"
					},
					"vscode-pokemon.position": {
						"type": "string",
						"enum": [
							"panel",
							"explorer"
						],
						"default": "explorer",
						"description": "포켓몬 패널 위치"
					},
					"vscode-pokemon.theme": {
						"type": "string",
						"enum": [
							"none",
							"forest",
							"castle",
							"beach"
						],
						"default": "none",
						"description": "배경 (none · forest 숲 · castle 성 · beach 해변)"
					},
					"vscode-pokemon.defaultPokemon": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"type": {
									"type": "string",
									"description": "Pokemon type (e.g., 'pikachu', 'charizard', 'bulbasaur'), or 'random' to spawn a random species"
								},
								"name": {
									"type": "string",
									"description": "Custom name for the pokemon (optional)"
								},
								"shiny": {
									"type": "boolean",
									"description": "Force this pokemon to be shiny (true) or non-shiny (false). If omitted, uses vscode-pokemon.shinyOdds (optional)"
								},
								"pool": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"description": "When type is 'random', restrict the random selection to this list of pokemon species (e.g. ['pikachu', 'eevee', 'gengar']). Ignored for non-random types (optional)"
								}
							},
							"required": [
								"type"
							]
						},
						"default": [],
						"description": "기본 포켓몬 — 패널이 빈 채로 시작할 때(새 작업 폴더 · 처음 켤 때) 자동으로 소환. ⚙ 설정 버튼에서 고르면 편함. type 은 포켓몬 키(예: pikachu) 또는 'random', name · shiny · pool 은 선택"
					},
					"vscode-pokemon.shinyOdds": {
						"type": "number",
						"default": 8192,
						"minimum": 1,
						"description": "색이 다른 개체가 나올 확률 (N 마리 중 1). 낮을수록 자주 나옴, 기본 8192"
					},
					"vscode-pokemon.pokemonLanguage": {
						"type": "string",
						"enum": [
							"ko",
							"auto",
							"en-US",
							"fr-FR",
							"de-DE",
							"ja-JP"
						],
						"default": "ko",
						"description": "포켓몬 이름 언어. 기본은 한국어 — 'auto' 도 한국어로 나옴"
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile:panel": "webpack",
		"compile:extension": "tsc -p ./tsconfig.extension.json",
		"compile:test": "tsc -p ./tsconfig.test.json",
		"compile:web": "webpack",
		"compile": "npm run compile:panel && npm run compile:extension && npm run compile:test && npm run compile:web",
		"watch": "webpack && tsc -watch -p ./tsconfig.extension.json",
		"watch:web": "webpack --watch",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"lint:fix": "eslint src --ext ts --fix",
		"format:check": "prettier --check src",
		"format": "prettier --write src",
		"test": "node ./out/test/runTest.js",
		"test:coverage": "COVERAGE=1 node ./out/test/runTest.js",
		"test:web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
		"test:gifs": "node ./out/test/gifs.js",
		"prepare": "husky"
	},
	"devDependencies": {
		"@rbarilani/remove-source-map-url-webpack-plugin": "^1.1.0",
		"@types/glob": "^7.1.3",
		"@types/jsdom": "^20.0.0",
		"@types/mocha": "^9.1.1",
		"@types/node": "^18.0.0",
		"@types/vscode": "^1.73.0",
		"@typescript-eslint/eslint-plugin": "^5.29.0",
		"@typescript-eslint/parser": "^5.29.0",
		"@vscode/l10n-dev": "^0.0.29",
		"@vscode/test-web": "^0.0.50",
		"eslint": "^8.18.0",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-unused-imports": "^2.0.0",
		"glob": "^8.0.3",
		"gulp": "^5.0.0",
		"husky": "^9.1.7",
		"jsdom": "^20.0.0",
		"jsdom-global": "^3.0.2",
		"mocha": "^10.0.0",
		"nyc": "^15.1.0",
		"path-browserify": "^1.0.1",
		"prettier": "^3.3.3",
		"process": "^0.11.10",
		"ts-loader": "^9.3.0",
		"typescript": "^4.7.4",
		"typescript-eslint": "^0.0.1-alpha.0",
		"vscode-test": "^1.4.0",
		"webpack": "5.95.0",
		"webpack-cli": "^4.10.0"
	},
	"dependencies": {
		"@vscode/l10n": "^0.0.10"
	},
	"lint-staged": {
		"*.ts": [
			"eslint --fix",
			"prettier --write"
		]
	}
}
