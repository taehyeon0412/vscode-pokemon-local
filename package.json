{
  "name": "vscode-pokemon-local-dev",
  "private": true,
  "description": "게임 모드 개발 도구 (개발 PC에만). 확장 자체는 extension/package.json",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/build.mjs --release --tests && node .test-out/run-integration.cjs",
    "typecheck": "tsc -p src/game/tsconfig.core.json && tsc -p src/game/tsconfig.host.json && tsc -p src/game/tsconfig.webview.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "18.19.130",
    "@types/vscode": "1.73.0",
    "@vscode/test-electron": "2.5.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "preact": "10.29.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
